.DS_Store
.trash/

# L'état de l'espace de travail Obsidian change à chaque ouverture de panneau.
# Les *réglages* du vault, eux, méritent d'être versionnés.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# SBL Hebrew relève d'un EULA propriétaire : la committer, c'est la
# redistribuer. Elle reste sur le disque pour composer dans Affinity, mais ne
# quitte pas cette machine. Ezra SIL, Frank Ruhl Libre et Taamey Frank CLM
# sont sous licences libres et restent versionnées (cf. CLAUDE.md §2.5).
utilities/SBL_Hbrw.ttf

# Verrous Affinity — transitoires, ils n'existent que pendant l'édition.
*~lock~

# La maquette Affinity ne voyage plus dans le dépôt. C'étaient douze méga de
# binaires opaques — le document de composition, ses exports, les photos de
# travail — que git ne sait ni différencier ni fusionner : chaque
# enregistrement pesait son poids entier, et personne n'a jamais pu lire un
# diff. Le dépôt porte le *texte* et ses conventions ; la mise en page est un
# aval, et elle vit sur le disque de l'auteur.
#
# Les fichiers restent en place, simplement plus suivis. L'historique, lui,
# garde les versions déjà committées.
af/

# Le cache de bytecode Python du script de balisage.
__pycache__/
